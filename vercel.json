{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/auth/callback/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/downgrade-expired-trials",
      "schedule": "0 0 * * *"
    }
  ]
}
