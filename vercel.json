{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "installCommand": "npm install && npm --prefix frontend install",
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/manage.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/checkout.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/checkoutbackup.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/success.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cancel.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/auth/callback",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/auth/callback/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}
